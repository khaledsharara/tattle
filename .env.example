# Tattle settings. install.sh writes this file for you; every value has a default.
# After a change: docker compose up -d   (add --profile gateway in gateway mode)

# How Tattle counts: quota (provider figures only), router (a supported router's
# per-device counters) or gateway (this server becomes the network's gateway).
TATTLE_MODE=quota

# Your time zone, so "today" and the renewal day are yours.
TZ=UTC

# The dashboard's port: http://<this server>:8090
TATTLE_PORT=8090

# Which image to run (a release like 0.1.0, or latest).
TATTLE_VERSION=latest

# Optional: an admin password from here instead of choosing one in the browser.
# TATTLE_ADMIN_PASSWORD=

# --- gateway mode only (install.sh detects these) ---------------------------
# The wired network interface, this server's (static) address, the network, the router.
# TATTLE_LAN_IF=eth0
# TATTLE_SERVER_IP=192.168.1.10
# TATTLE_LAN=192.168.1.0/24
# TATTLE_ROUTER_IP=192.168.1.1
# Addresses Tattle hands out (keep the router, this server and fixed devices outside it).
# TATTLE_DHCP_RANGE=192.168.1.50,192.168.1.250
# Where DNS lookups go (default: the router).
# TATTLE_DNS=192.168.1.1
# Hide IPv6 addresses from DNS answers if the router's IPv6 can't be turned off.
# TATTLE_FILTER_AAAA=0

# The fastest your line can go, in Mbps (a counter that "moves" faster restarted).
# TATTLE_MAX_MBPS=1000
